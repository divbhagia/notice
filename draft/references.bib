@incollection{Mortensen1986,
	abstract = {The theory of search is an important young actor on the stage of economic analysis. It plays a major part in a dramatic new field, the economics of information and uncertainty. By exploiting its sequential statistical decision theoretic origins, the search theory has found success by specializing in the portrayal of a decision-maker who must acquire and use information to take rational action in an ever changing and uncertain environment. Although the search theory's specific characterizations can now be found in many arenas of applied economic analysis, most of the theory's original roles are found in the labor economics literature. This chapter reviews the search theory's performances to date in labor market analysis. In a given population of labor force participants, the steady state fractions that are unemployed are equal to the product of the average frequency and duration of unemployment spells. The data sources reveal that unemployment spells are typically frequent but short in all phases of the business cycle, although counter-cyclic increases in both frequency and duration contribute to the well-known time series behavior of unemployment rates.},
	author = {Mortensen, Dale T.},
	booktitle = {Handbook of {{Labor Economics}}},
	doi = {10.1016/S1573-4463(86)02005-9},
