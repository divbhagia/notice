@article{MarinescuSkandalis2021,
	abstract = {How does unemployment insurance (UI) affect unemployed workers' search behavior? Search models predict that until benefit exhaustion, UI depresses job search effort and increases reservation wages. Over an unemployment spell, search effort should increase up to benefit exhaustion and stay high thereafter. Meanwhile, reservation wages should decrease up to benefit exhaustion and stay low thereafter. To test these predictions, we link administrative registers to data on job search behavior from a major online job search platform in France. We follow over 400,000 workers, as long as they remain unemployed. We analyze the changes in search behavior around benefits exhaustion and take two steps to isolate the individual response to unemployment benefits. First, our longitudinal data allows us to correct for changes in sample composition over the spell. Second, we exploit data on workers eligible for 12\textendash 24 months of UI as well as workers ineligible for UI, to control for behavior changes over the unemployment spell that are independent of UI. Our results confirm the predictions of search models. We find that search effort (the number of job applications) increases by at least 50\% during the year preceding benefits exhaustion and remains high thereafter. The target monthly wage decreases by at least 2.4\% during the year preceding benefits exhaustion and remains low thereafter. In addition, we provide evidence for duration dependence: workers decrease the wage they target by 1.5\% over each year of unemployment, irrespective of their UI status.},
	author = {Marinescu, Ioana and Skandalis, Daphn{\'e}},
	doi = {10.1093/qje/qjaa037},
	file = {/Users/divyabhagia/Zotero/storage/LEHN4F2J/Marinescu and Skandalis - 2021 - Unemployment Insurance and Job Search Behavior.pdf},
	issn = {0033-5533},
	journal = {The Quarterly Journal of Economics},
	month = may,
	number = {2},
	pages = {887--931},
	title = {Unemployment {{Insurance}} and {{Job Search Behavior}}*},
	volume = {136},
	year = {2021},
	bdsk-url-1 = {https://doi.org/10.1093/qje/qjaa037}}

@article{Meyer1990,
	abstract = {This paper tests the effects of the level and length of unemployment insurance (UI) benefits on unemployment durations. The paper particularly studies individual behavior during the weeks just prior to when benefits lapse. Higher UI benefits are found to have a strong negative effect on the probability of leaving unemployment. However, the probability of leaving unemployment rises dramatically just prior to when benefits lapse. When the length of benefits is extended, the probability of a spell ending is high in the week benefits were previously expected to lapse. Individual data are used with accurate information on spell durations, and the level and length of benefits. Semiparametric estimation techniques are used and compared to alternative approaches. The semiparametric approach yields more plausible estimates and provides useful diagnostics.},
	author = {Meyer, Bruce D.},
