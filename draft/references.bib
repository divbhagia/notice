	month = nov,
	number = {4},
	pages = {1969--2018},
	shorttitle = {Reference-{{Dependent Job Search}}},
	title = {Reference-{{Dependent Job Search}}: {{Evidence}} from {{Hungary}}*},
	volume = {132},
	year = {2017},
	bdsk-url-1 = {https://doi.org/10.1093/qje/qjx015}}

