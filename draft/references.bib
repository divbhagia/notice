	title = {Why Is {{There}} a {{Spike}} in the {{Job Finding Rate}} at {{Benefit Exhaustion}}?},
	volume = {160},
	year = {2012},
	bdsk-url-1 = {https://doi.org/10.1007/s10645-012-9187-8}}

